# Astro
dist/
.astro/

# Dependencies
node_modules/

# Generated at every build by scripts/build-tokens.ts from the brand kit's
# DESIGN.md. A build artefact, not a source of truth — change the kit
# (/mnt/persistent/git/branding/henley/DESIGN.md) or the generator, never this.
src/styles/tokens.css

# Local environment
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store

# fontTools venv created on demand by scripts/build-fonts.sh
.venv-fonts/

# Receiver test venv (forms/README.md explains how to recreate it)
forms/.venv/
__pycache__/
.pytest_cache/

# Playwright MCP scratch output
.playwright-mcp/
*.png
!public/**/*.png
!src/**/*.png

# Review imagery pulled from SharePoint and the old site (600 MB of originals
# plus contact sheets). The READMEs and inventories are the record; the files
# themselves are re-fetchable and go into src/images only once chosen.
assets/**
!assets/*/
!assets/*/README.md
!assets/*/*-inventory.md

# Replica (stream/replica). The export is committed, including its PNG
# favicons, which the blanket *.png rule above would otherwise drop, and the
# wp-includes/wp-content "dist" asset directories WordPress itself names,
# which the Astro dist/ rule above would otherwise drop (git will not look
# inside an ignored directory, so both the directory and its contents need
# re-including).
!replica/site/**/*.png
!replica/site/**/dist/
!replica/site/**/dist/**
replica/screenshots/
replica/__pycache__/
replica/tests/__pycache__/
