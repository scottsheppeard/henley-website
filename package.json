{
  "name": "henley-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "thehenley.com.au \u2014 static site for The Henley on Broadwater",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "tokens": "node scripts/build-tokens.ts",
    "export:content": "node scripts/export-content.ts",
    "redirects": "node scripts/build-nginx-redirects.ts",
    "fonts": "scripts/build-fonts.sh",
    "prebuild": "npm run tokens",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test scripts/*.test.ts",
    "test:update": "UPDATE_SNAPSHOTS=1 node --test scripts/*.test.ts",
    "check:enquiry": "scripts/check-enquiry-flow.sh",
    "check:proxy": "scripts/check-proxy-trust.sh",
    "check:urls": "scripts/check-urls.sh",
    "check:urls:fixture": "scripts/check-urls-fixture.sh",
    "assets": "scripts/build-assets.sh",
    "check": "npm run tokens && astro check && npm test",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@types/turndown": "5.0.6",
    "cheerio": "1.2.0",
    "js-yaml": "5.4.1",
    "sharp": "0.35.4",
    "turndown": "7.2.4",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
