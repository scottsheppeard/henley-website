---
/**
 * Contact.
 *
 * Three audiences land here and only one of them is a lead. Someone who already
 * lives at The Henley, or whose parent does, wants reception or the maintenance
 * form — and should not have to scroll past a sales form to find them.
 *
 * That was the intent before, and the layout did not deliver it: the residents'
 * routes sat in a band *after* the whole form, which on a phone is most of a
 * screen of scrolling past questions that are not for them. The callout is now
 * the first thing after the heading, in document order and in reading order,
 * and it is two lines rather than a panel — so a prospective resident still
 * sees the contact details and the form immediately below it.
 *
 * The form is not pre-ticked here: reached from the nav, this page has no
 * context to infer an interest from, so it asks properly.
 */
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { ADDRESS, EMAIL, MAINTENANCE_FORM, PHONE, PHONE_HREF, SOCIAL } from '../site.ts';
---

<Base
  title="Contact us | The Henley on Broadwater"
  description="Call 07 5591 2111, email info@thehenley.com.au, or send an enquiry. The Henley on Broadwater, 70 Marine Parade, Southport."
>
  <section class="band contact">
    <div class="wrap contact__grid">
      <div class="contact__details">
        <h1>Get in touch</h1>

        <aside class="resident" aria-labelledby="residents">
          <h2 id="residents">Already live here?</h2>
          <p>
            You do not need the enquiry form. Call reception on{' '}
            <a class="nowrap" href={PHONE_HREF}>{PHONE}</a>, or{' '}
            <a href={MAINTENANCE_FORM.href} rel="noopener" target="_blank">
              lodge a maintenance request<span class="visually-hidden"> (opens in a new tab)</span></a>.
          </p>
        </aside>

        <div class="detail">
          <h2>Call us</h2>
          <p class="detail__value"><a href={PHONE_HREF}>{PHONE}</a></p>
          <p class="detail__note">Reception is open weekdays. Someone answers.</p>
        </div>

        <div class="detail">
          <h2>Email</h2>
          <p class="detail__value"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        </div>

        <div class="detail">
          <h2>Visit</h2>
          <p class="detail__value">
            <address>
              {ADDRESS.street}<br />
              {ADDRESS.suburb} {ADDRESS.state} {ADDRESS.postcode}
            </address>
          </p>
          <p class="detail__note">
            Across from the Broadwater Parklands, with parking at the door.
          </p>
        </div>

        <div class="detail">
          <h2>Follow</h2>
          <p class="detail__value">
            {
              SOCIAL.map((link, index) => (
                <>
                  {index > 0 && ' and '}
                  <a href={link.href} rel="noopener me">
                    {link.label}
                  </a>
                </>
              ))
            }
          </p>
        </div>
      </div>

      <div class="contact__form">
        <EnquiryForm heading="Send an enquiry" />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  /* Two lines and a border, not a panel. Enough for a resident to recognise as
     theirs and skip past; small enough that it does not become the page. */
  .resident {
    background: var(--color-linen);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-block-end: var(--space-2xl);
  }

  .resident h2 {
    font: var(--type-title-lg);
    letter-spacing: var(--type-title-lg-letter-spacing);
    margin-block-end: var(--space-2xs);
  }

  .resident p {
    font: var(--type-body-md);
    margin: 0;
  }

  .detail {
    margin-block-end: var(--space-2xl);
  }

  .detail h2 {
    font: var(--type-label-md);
    letter-spacing: var(--type-label-md-letter-spacing);
    /* Driftwood would be 3.78:1 here, under the text minimum. */
    color: var(--color-on-surface-secondary);
    margin-block-end: var(--space-2xs);
  }

  .detail__value {
    font: var(--type-title-lg);
    margin: 0;
  }

  .detail__value address {
    font-style: normal;
  }

  .detail__note {
    font: var(--type-body-md);
    color: var(--color-on-surface-secondary);
    margin-block: var(--space-xs) 0;
  }

  @media (max-width: 56rem) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
