---
/**
 * The horizon hero.
 *
 * A photograph, then a hard edge, then the words on Broadwater Deep beneath it.
 * The type never sits on the image.
 *
 * That is the site's one structural idea, and it earns its place twice. It is
 * the Broadwater — sky, then water, and the deep band is the water. And it
 * means no scrim, no gradient wash and no guessing: the headline is Paper on
 * #083B4A at 13:1, on every page, whatever photograph is behind it. Text over
 * a photograph is the default treatment for a hero like this, and it is the
 * one that fails on a bright phone screen in daylight, which is exactly where
 * this audience reads it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** The tagline or page heading. Rendered as the page's h1. */
  heading: string;
  /** One sentence saying plainly what this is. A tagline alone explains nothing. */
  standfirst: string;
  /** Shorter image on inner pages: the home page gets the full view. */
  size?: 'full' | 'inner';
}

const { image, alt, heading, standfirst, size = 'inner' } = Astro.props;
---

<section class={`hero hero--${size} on-deep`}>
  <div class="hero__image">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__band">
    <div class="wrap">
      <h1>{heading}</h1>
      <p class="hero__standfirst">{standfirst}</p>
      <slot />
    </div>
  </div>
</section>

<style>
  .hero__image {
    /* A fixed aspect rather than a viewport height: the image keeps its
       proportions instead of being cropped to a strip on a laptop and a
       column on a phone, and nothing shifts as the page loads. */
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }

  .hero--inner .hero__image {
    aspect-ratio: 21 / 6;
  }

  .hero__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The horizon. */
  .hero__band {
    background: var(--color-broadwater-deep);
    color: var(--color-linen);
    /* The extra radius-xl at the foot is what the next band's rounded
       corners overlap (see .hero + .band in global.css). */
    padding-block: var(--space-2xl) calc(var(--space-3xl) + var(--radius-xl));
  }

  .hero__band :global(h1) {
    color: var(--color-paper);
    margin-block-end: var(--space-lg);
    max-width: 20ch;
  }

  .hero__standfirst {
    font: var(--type-body-lg);
    color: var(--color-warm-sand);
    max-width: 54ch;
    margin: 0;
  }

  @media (max-width: 48rem) {
    .hero__image,
    .hero--inner .hero__image {
      /* Taller on a phone: a 21:6 letterbox at 360px wide is 100px of nothing. */
      aspect-ratio: 4 / 3;
      min-height: 240px;
    }

    .hero__band :global(h1) {
      font: var(--type-headline-lg);
      max-width: none;
    }
  }
</style>
