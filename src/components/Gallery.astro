---
/**
 * Three photographs in a row, each with a caption that says what it is.
 *
 * Captions are not optional decoration here: the audience is deciding whether
 * to move house, and "which room is this, in which apartment type?" is the
 * question they ask of every picture. A caption answers it; a mood board does
 * not. Three across on a desktop, one column on a phone, and the images are
 * lazy — nothing here is above the fold.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  photos: Photo[];
  ground?: 'paper' | 'linen';
}

const { photos, ground = 'paper' } = Astro.props;
---

<section class={`band band--gallery ${ground === 'linen' ? 'band--linen' : ''}`}>
  <div class="wrap">
    <ul class="gallery">
      {
        photos.map(({ image, alt, caption }) => (
          <li>
            <figure>
              <Image
                src={image}
                alt={alt}
                widths={[480, 720, 1080]}
                sizes="(max-width: 56rem) 100vw, 33vw"
                format="avif"
                loading="lazy"
              />
              <figcaption>{caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band--gallery {
    padding-block: 0 var(--space-3xl);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
    /* Lists are capped at a reading measure globally; a row of photographs
       is not prose and takes the full column. */
    max-width: none;
  }

  figure {
    margin: 0;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  figcaption {
    font: var(--type-body-sm);
    color: var(--color-on-surface-secondary);
    padding-block-start: var(--space-sm);
  }

  @media (max-width: 56rem) {
    .gallery {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
