---
/**
 * One of the two ways to live here.
 *
 * A full-width band, photograph on one side and words on the other, alternating
 * which side. Deliberately not two matching cards in a grid: cards say "here
 * are two products, pick one", and these are two different decisions made by
 * different people on different timescales. Giving each the full width, its own
 * photograph and its own ground says that instead.
 *
 * It also collapses honestly. On a phone the image sits above the words and
 * nothing is squeezed into a column half the width it was drawn for.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  heading: string;
  href: string;
  linkLabel: string;
  /** Puts the photograph on the right. Alternate down the page. */
  reversed?: boolean;
  ground?: 'paper' | 'linen';
}

const { image, alt, heading, href, linkLabel, reversed = false, ground = 'paper' } = Astro.props;
---

<section class={`path ${ground === 'linen' ? 'path--linen' : ''} ${reversed ? 'path--reversed' : ''}`}>
  <div class="path__image">
    <Image src={image} alt={alt} widths={[480, 720, 1080]} sizes="(max-width: 56rem) 100vw, 50vw" format="avif" loading="lazy" />
  </div>
  <div class="path__body">
    <div class="path__text">
      <h2>{heading}</h2>
      <slot />
      <p class="path__link"><a href={href}>{linkLabel}</a></p>
    </div>
  </div>
</section>

<style>
  .path {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--color-paper);
  }

  .path--linen {
    background: var(--color-linen);
  }

  .path--reversed .path__image {
    order: 2;
  }

  .path__image {
    aspect-ratio: 4 / 3;
  }

  .path__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .path__body {
    display: flex;
    align-items: center;
    padding: var(--space-3xl);
  }

  /* The text column is measured from the page, not the band, so the two bands
     line up with everything above and below them however wide the screen is. */
  .path__text {
    max-width: 34rem;
  }

  .path--reversed .path__body {
    justify-content: flex-end;
  }

  .path__link a {
    font: var(--type-title-md);
  }

  @media (max-width: 56rem) {
    .path {
      grid-template-columns: 1fr;
    }

    .path--reversed .path__image {
      order: 0;
    }

    .path__image {
      aspect-ratio: 16 / 9;
    }

    .path__body {
      padding: var(--space-xl) var(--space-lg) var(--space-2xl);
    }
  }
</style>
